{
  "title": "자동매매 · 키움 미국 — 장중 루프 (5분)",
  "cronTime": "0 */5 8-16 * * 1-5",
  "zone": "America/New_York",
  "executionMode": "pipeline",
  "pipeline": [
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "gate",
        "broker": "kiwoom-trade",
        "account": "모의해외",
        "market": "us"
      }
    },
    {
      "type": "CONDITION",
      "field": "active",
      "op": "==",
      "value": true
    },
    {
      "type": "FOREACH",
      "items": "$step0.trades",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_kiwoom",
          "inputData": {
            "action": "get_candles",
            "bars": 300
          },
          "inputMap": {
            "symbol": "$prev.symbol",
            "interval": "$prev.interval",
            "account": "$prev.account",
            "market": "$prev.market"
          }
        }
      ],
      "continueOnError": true
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "bind_bars",
        "feeRate": 0.0025,
        "taxRate": 0.0,
        "slippageRate": 0.0005
      },
      "inputMap": {
        "trades": "$step0.trades",
        "fetched": "$step2"
      }
    },
    {
      "type": "FOREACH",
      "items": "$step3.runs",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_technical-analysis",
          "inputData": "$prev.args"
        }
      ],
      "continueOnError": true
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_kiwoom-trade",
      "inputData": {
        "action": "list_open_orders"
      },
      "inputMap": {
        "account": "$step0.scopedTo.account",
        "market": "$step0.scopedTo.market"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "cycle"
      },
      "inputMap": {
        "plan": "$step3",
        "signals": "$step4",
        "openOrders": "$step5.rows"
      }
    },
    {
      "type": "FOREACH",
      "items": "$step6.calls",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_kiwoom-trade",
          "inputData": "$prev.input"
        }
      ],
      "continueOnError": true
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "record_orders"
      },
      "inputMap": {
        "calls": "$step6.calls",
        "results": "$step7"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_kiwoom-trade",
      "inputData": {
        "action": "list_fills"
      },
      "inputMap": {
        "account": "$step0.scopedTo.account",
        "market": "$step0.scopedTo.market"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_kiwoom-trade",
      "inputData": {
        "action": "list_open_orders"
      },
      "inputMap": {
        "account": "$step0.scopedTo.account",
        "market": "$step0.scopedTo.market"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_kiwoom-trade",
      "inputData": {
        "action": "get_balance"
      },
      "inputMap": {
        "account": "$step0.scopedTo.account",
        "market": "$step0.scopedTo.market"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "reconcile"
      },
      "inputMap": {
        "broker": "$step0.scopedTo.broker",
        "account": "$step0.scopedTo.account",
        "fills": "$step9.rows",
        "openOrders": "$step10.rows",
        "balanceRows": "$step11.rows",
        "market": "$step0.scopedTo.market"
      }
    }
  ]
}
