{
  "title": "autotrade (가상화폐/업비트) — 전 종목 사이클",
  "cronTime": "0 */5 * * * *",
  "executionMode": "pipeline",
  "pipeline": [
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "gate"
      }
    },
    {
      "type": "CONDITION",
      "field": "active",
      "op": "==",
      "value": true
    },
    {
      "type": "FOREACH",
      "items": "$step0.trades",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_upbit",
          "inputData": {
            "action": "get_candles",
            "bars": 300
          },
          "inputMap": {
            "symbol": "$prev.symbol",
            "interval": "$prev.interval"
          }
        }
      ]
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "bind_bars",
        "feeRate": 0.0005,
        "taxRate": 0,
        "slippageRate": 0.0002
      },
      "inputMap": {
        "trades": "$step0.trades",
        "fetched": "$step2"
      }
    },
    {
      "type": "FOREACH",
      "items": "$step3.runs",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_technical-analysis",
          "inputData": "$prev.args"
        }
      ]
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "cycle"
      },
      "inputMap": {
        "plan": "$step3",
        "signals": "$step4"
      }
    },
    {
      "type": "FOREACH",
      "items": "$step5.calls",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_upbit",
          "inputData": "$prev.input"
        }
      ]
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "record_orders"
      },
      "inputMap": {
        "calls": "$step5.calls",
        "results": "$step6"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_upbit",
      "inputData": {
        "action": "list_fills"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_upbit",
      "inputData": {
        "action": "list_open_orders"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_upbit",
      "inputData": {
        "action": "get_balance"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "reconcile"
      },
      "inputMap": {
        "fills": "$step8.rows",
        "openOrders": "$step9.rows",
        "balanceRows": "$step10.rows"
      }
    }
  ]
}
