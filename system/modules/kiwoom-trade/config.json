{
  "name": "kiwoom-trade",
  "type": "module",
  "scope": "system",
  "version": "1.0.0",
  "description": "키움증권 계좌·주문 — 국내·미국주식 주문(신규·정정·취소·신용)·잔고·예수금·체결내역·주문가능금액·입출금·환전. 계좌 등록(앱키·계좌번호)이 있는 쪽.",
  "aliases": [
    "키움",
    "키움증권",
    "Kiwoom"
  ],
  "runtime": "node",
  "capability": "stock-order",
  "providerType": "api",
  "accounts": {
    "modes": [
      "real",
      "mock"
    ],
    "markets": [
      "kr",
      "us"
    ],
    "listAction": "ka00001",
    "accountNoPath": "acctNo"
  },
  "secrets": [
    {
      "name": "KIWOOM_APP_KEY",
      "type": "key"
    },
    {
      "name": "KIWOOM_APP_SECRET",
      "type": "key"
    },
    {
      "name": "KIWOOM_ACCESS_TOKEN",
      "type": "token",
      "lifetimeSec": 85800,
      "oauth": {
        "base": "https://api.kiwoom.com",
        "baseMock": "https://mockapi.kiwoom.com",
        "path": "/oauth2/token",
        "method": "POST",
        "contentType": "application/json;charset=UTF-8",
        "body": {
          "grant_type": "client_credentials",
          "appkey": "${KIWOOM_APP_KEY}",
          "secretkey": "${KIWOOM_APP_SECRET}"
        },
        "tokenField": "token",
        "invalidWhen": {
          "match": "any",
          "conditions": [
            {
              "field": "return_code",
              "equals": 3
            },
            {
              "field": "return_msg",
              "regex": "(?i)Token이 유효하지 않습니다|token.*invalid"
            }
          ]
        }
      }
    }
  ],
