        "description": "키움 계좌·주문 API ID 직접 호출 (예: kt10000 매수 / kt00018 잔고). place_order · cancel_order · list_open_orders · list_fills · get_balance = 증권사 중립 계약 — 이 증권사의 API ID 를 몰라도 되는 표준 호출. 시세·차트·조건검색은 이 모듈에 없습니다 — `kiwoom` 모듈입니다."
      },
      "params": {
        "type": "object",
        "description": "키움 API request body 의 모든 필드. 각 API 의 필드는 키움 REST API 공식 문서 참조."
      },
      "account": {
        "type": "string",
        "description": "Registered account alias to run as (omit = primary account)."
      },
      "mock": {
        "type": "boolean",
        "description": "true 면 모의투자 도메인 (mockapi.kiwoom.com) 호출. 기본 false (실전)."
      },
      "side": {
        "type": "string",
        "enum": [
          "buy",
          "sell"
        ],
        "description": "place_order 매수/매도. 조회(list_open_orders·list_fills)에서는 필터이며, 생략하면 매수·매도 전체입니다."
      },
      "symbol": {
        "type": "string",
        "description": "종목코드 6자리 (예: 005930). 조회에서는 생략하면 계좌 전체입니다."
      },
      "qty": {
        "type": "number",
        "description": "주문 수량 (1 이상 정수)."
      },
      "price": {
        "type": "number",
        "description": "지정가 주문 단가. 시장가면 생략."
      },
      "orderType": {
        "type": "string",
        "enum": [
          "limit",
          "market",
          "conditional",
          "best",
          "priority"
        ],
        "description": "주문 유형 (기본 limit). 지정가에는 price 필수."
      },
      "exchange": {
        "type": "string",
        "enum": [
          "KRX",
          "NXT",
          "SOR"
        ],
        "description": "거래소 구분 (기본 SOR = 통합)."
      },
      "conditionPrice": {
        "type": "number",
        "description": "orderType=conditional 의 조건 단가."
      },
      "brokerOrderNo": {
        "type": "string",
        "description": "cancel_order 대상 원주문번호."
      },
      "clientOrderId": {
        "type": "string",
        "description": "호출자의 주문 식별자. 그대로 되돌려주므로 원장이 재전송과 중복 체결을 구분할 수 있습니다."
      },
      "beforeOrderNo": {
        "type": "string",
        "description": "list_fills 페이징 — 이 주문번호보다 **과거** 체결을 돌려줍니다(뒤로 넘깁니다)."
      },
      "interval": {
        "type": "string",
        "description": "봉 주기: 1m·3m·5m·10m·15m·30m·45m·60m(=1h)·1d·1w·1M·1y, 또는 `100t` 같은 틱 단위. 기본 1d."
      },
      "bars": {
        "type": "integer",
        "description": "get_candles: how many bars to return, newest first. The venue answers one page at a time and this pages through its continuation cursor until the count is met (capped at 20 pages). Omit to take a single page as the venue returns it."
      },
      "market": {
        "type": "string",
        "enum": [
          "kr",
          "us"
        ],
        "description": "get_candles 대상 시장 (기본 kr)."
      },
      "baseDate": {
        "type": "string",
        "description": "get_candles 기준일 YYYY-MM-DD (이 날짜부터 과거로)."
      },
      "adjusted": {
        "type": "boolean",
        "description": "수정주가 적용 (기본 true)."
      },
      "stexTp": {
        "type": "string",
        "description": "미국 거래소 구분 (NA/ND/NY, 기본 ND)."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "apiId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      }
    }
  },
  "actionCatalog": {
    "file": "actions.json",
    "envelope": "{ \"action\": \"<id>\", \"params\": { <params from actions.json> } }"
  },
