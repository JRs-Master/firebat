          "get_candles"
        ],
        "description": "키움 시세 API ID 직접 호출 (예: ka10001 현재가 / ka10081 일봉). get_candles = 증권사 중립 캔들 계약. 주문·잔고·환전 액션은 이 모듈에 없습니다 — `kiwoom-trade` 모듈입니다."
      },
      "params": {
        "type": "object",
        "description": "키움 API request body 의 모든 필드. 각 API 의 필드는 키움 REST API 공식 문서 참조."
      },
      "mock": {
        "type": "boolean",
        "description": "true 면 모의투자 도메인 (mockapi.kiwoom.com) 호출. 기본 false (실전)."
      },
      "side": {
        "type": "string",
        "enum": [
          "buy",
          "sell"
        ],
        "description": "place_order 매수/매도. 조회(list_open_orders·list_fills)에서는 필터이며, 생략하면 매수·매도 전체입니다."
      },
      "symbol": {
        "type": "string",
        "description": "종목코드 6자리 (예: 005930). 조회에서는 생략하면 계좌 전체입니다."
      },
      "qty": {
        "type": "number",
        "description": "주문 수량 (1 이상 정수)."
      },
      "price": {
        "type": "number",
        "description": "지정가 주문 단가. 시장가면 생략."
      },
      "orderType": {
        "type": "string",
        "enum": [
          "limit",
          "market",
          "conditional",
          "best",
          "priority"
        ],
        "description": "주문 유형 (기본 limit). 지정가에는 price 필수."
      },
      "exchange": {
        "type": "string",
        "enum": [
          "KRX",
          "NXT",
          "SOR"
        ],
        "description": "거래소 구분 (기본 SOR = 통합)."
      },
      "conditionPrice": {
        "type": "number",
        "description": "orderType=conditional 의 조건 단가."
      },
      "brokerOrderNo": {
        "type": "string",
        "description": "cancel_order 대상 원주문번호."
      },
      "clientOrderId": {
        "type": "string",
        "description": "호출자의 주문 식별자. 그대로 되돌려주므로 원장이 재전송과 중복 체결을 구분할 수 있습니다."
      },
      "beforeOrderNo": {
        "type": "string",
        "description": "list_fills 페이징 — 이 주문번호보다 **과거** 체결을 돌려줍니다(뒤로 넘깁니다)."
      },
      "interval": {
        "type": "string",
        "description": "봉 주기: 1m·3m·5m·10m·15m·30m·45m·60m(=1h)·1d·1w·1M·1y, 또는 `100t` 같은 틱 단위. 기본 1d."
      },
      "bars": {
        "type": "integer",
        "description": "get_candles: how many bars to return, newest first. The venue answers one page at a time and this pages through its continuation cursor until the count is met (capped at 20 pages). Omit to take a single page as the venue returns it."
      },
      "market": {
        "type": "string",
        "enum": [
          "kr",
          "us"
        ],
        "description": "get_candles 대상 시장 (기본 kr)."
      },
      "baseDate": {
        "type": "string",
        "description": "get_candles 기준일 YYYY-MM-DD (이 날짜부터 과거로)."
      },
      "adjusted": {
        "type": "boolean",
        "description": "수정주가 적용 (기본 true)."
      },
      "stexTp": {
        "type": "string",
        "description": "미국 거래소 구분 (NA/ND/NY, 기본 ND)."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "apiId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      }
    }
  },
  "actionCatalog": {
    "file": "actions.json",
    "envelope": "{ \"action\": \"<id>\", \"params\": { <params from actions.json> } }"
  },
  "grounding": {
    "stk_cd": {
      "resolveHint": "A stock code (stk_cd) must come from a lookup, never from memory. To resolve a company name to its code, call the stock-lookup tool directly NOW: sysmod_stock-lookup {\"query\":\"<company name>\"} (underscore form sysmod_stock_lookup also works). One arg, one call — this is a direct tool call, NOT something to find with search_module_actions (never search for \"lookup\"). It returns the official corp_name + stock_code (e.g. LG에너지솔루션 → 373220); if several companies match it returns candidates — ask the user with a suggest picker when unsure. Alternatively ka10100 can confirm a code you were given. Use the returned stock_code as-is, and don't re-guess the name if a lookup already returned a code.",
      "exemptActions": [
        "ka10100"
      ]
    }
  },
  "tags": [
    "국내주식",
    "미국주식",
    "시세",
    "현재가",
    "호가",
    "체결",
    "차트",
    "캔들",
    "순위",
    "투자자매매동향",
    "업종",
    "ETF",
    "ELW",
    "조건검색",
    "실시간 스트림",
    "거래소 구분: KRX · NXT(넥스트레이드 대체거래소) · 통합/SOR — stk_cd 프리픽스(KRX:005930 / NXT:005930 / SOR:005930_AL) 또는 stex_tp(1.KRX 2.NXT 3.통합)"
  ],
  "pageBinding": {
    "alias": "kstock",
    "action": "ka10081",
    "args": {
      "upd_stkpc_tp": "1"
    },
    "blocks": [
      {
        "type": "stock_chart",
        "props": {
          "symbol": "{stk_cd}",
          "title": "{title}",
          "data": "$.stk_dt_pole_chart_qry",
          "indicators": [
            "MA5",
            "MA20",
            "MA60"
          ]
        }
      }
    ],
    "actions": {
      "ka10080": {
        "args": {
          "upd_stkpc_tp": "1",
          "tic_scope": "1"
        },
        "blocks": [
          {
            "type": "stock_chart",
            "props": {
              "symbol": "{stk_cd}",
              "title": "{title}",
              "data": "$.stk_min_pole_chart_qry",
              "indicators": [
                "MA5",
                "MA20"
              ]
            }
          }
        ]
      }
    }
  },
  "timeseries": {
    "ka10081": {
      "fetchMode": "cursor",
      "anchorParam": "base_dt",
      "countParam": "",
      "nextCursorField": "",
      "idParams": {
        "stk_cd": ""
      },
      "dateField": "date",
      "rows": [
        "stk_dt_pole_chart_qry",
        "records"
      ]
    }
  },
  "hubSafe": true,
  "secrets": [
    {
      "name": "KIWOOM_APP_KEY",
      "type": "key"
    },
    {
      "name": "KIWOOM_APP_SECRET",
      "type": "key"
    },
    {
      "name": "KIWOOM_ACCESS_TOKEN",
      "type": "token",
      "lifetimeSec": 85800,
      "oauth": {
        "base": "https://api.kiwoom.com",
        "baseMock": "https://mockapi.kiwoom.com",
        "path": "/oauth2/token",
        "method": "POST",
        "contentType": "application/json;charset=UTF-8",
        "body": {
          "grant_type": "client_credentials",
          "appkey": "${KIWOOM_APP_KEY}",
          "secretkey": "${KIWOOM_APP_SECRET}"
        },
        "tokenField": "token",
        "invalidWhen": {
          "match": "any",
          "conditions": [
            {
              "field": "return_code",
              "equals": 3
            },
            {
              "field": "return_msg",
              "regex": "(?i)Token이 유효하지 않습니다|token.*invalid"
            }
          ]
        }
      }
    }
  ],
  "accounts": {
    "modes": [
      "real",
      "mock"
    ],
    "markets": [
      "kr",
      "us"
    ],
    "listAction": "ka00001",
    "accountNoPath": "acctNo"
  },
  "credentialScope": "kiwoom-trade",
  "ws": {
    "argsField": "params",
    "endpoint": "wss://api.kiwoom.com:10000/api/dostk/websocket",
    "endpointMock": "wss://mockapi.kiwoom.com:10000/api/dostk/websocket",
    "matchField": "trnm",
    "echoValues": [
      "PING"
    ],
    "errorMsgField": "return_msg",
    "login": {
      "frame": {
        "trnm": "LOGIN",
        "token": "{TOKEN}"
      },
      "match": "LOGIN",
      "successWhen": {
        "field": "return_code",
        "equals": 0
      },
      "tokenSecret": "KIWOOM_ACCESS_TOKEN"
    },
    "actions": {
      "ka10171": {
        "frame": {
          "trnm": "CNSRLST"
        },
        "match": "CNSRLST",
        "successWhen": {
          "field": "return_code",
          "equals": 0
        }
      },
      "ka10172": {
        "preFrames": [
          {
            "frame": {
              "trnm": "CNSRLST"
            },
            "match": "CNSRLST",
            "successWhen": {
              "field": "return_code",
              "equals": 0
            }
          }
        ],
        "frame": {
          "trnm": "CNSRREQ",
          "seq": "{seq}",
          "search_type": "{search_type:0}",
          "stex_tp": "{stex_tp:K}",
          "cont_yn": "{cont_yn:N}",
          "next_key": "{next_key:}"
        },
        "match": "CNSRREQ",
        "successWhen": {
          "field": "return_code",
          "equals": 0
        }
      }
    },
    "unsupportedActions": [
      "ka10173",
      "ka10174",
      "usa20280",
      "usa20281",
      "usa20290",
      "usa20291"
    ],
    "shareConnection": true,
    "streams": {
      "quotes": {
        "subscribe": {
          "frame": {
            "trnm": "REG",
            "grp_no": "{grpNo}",
            "refresh": "1",
            "data": [
