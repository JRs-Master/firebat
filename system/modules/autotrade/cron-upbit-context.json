{
  "title": "자동매매 · 업비트 — 상위 주기 봉 캐시 (매일 00:10)",
  "cronTime": "0 10 0 * * *",
  "executionMode": "pipeline",
  "pipeline": [
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "context_plan",
        "broker": "upbit-trade"
      }
    },
    {
      "type": "CONDITION",
      "field": "runCount",
      "op": ">",
      "value": 0
    },
    {
      "type": "FOREACH",
      "items": "$step0.runs",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_upbit",
          "inputData": "$prev.args"
        }
      ]
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "store_context"
      },
      "inputMap": {
        "plan": "$step0",
        "results": "$step2.results"
      }
    }
  ]
}
