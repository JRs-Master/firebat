{
  "name": "upbit",
  "type": "module",
  "scope": "system",
  "version": "1.0.0",
  "description": "업비트 공개 시세 — 캔들(초·분·일·주·월·년)·체결·호가·티커·마켓 목록·거래대금 상위. 공개 엔드포인트라 자격증명을 선언하지 않습니다.",
  "aliases": [
    "업비트",
    "Upbit"
  ],
  "runtime": "node",
  "capability": "crypto-quote",
  "providerType": "api",
  "timeseries": {
    "candle-days": {
      "fetchMode": "cursor",
      "anchorParam": "to",
      "countParam": "count",
      "nextCursorField": "",
      "idParams": {
        "market": ""
      },
      "dateField": "candle_date_time_utc",
      "rows": [
        "items",
        "records"
      ]
    }
  },
  "ws": {
    "endpoint": "wss://api.upbit.com/websocket/v1",
    "matchField": "type",
    "shareConnection": true,
    "streams": {
      "trade": {
        "subscribe": {
          "frame": [
            {
              "ticket": "{ticket:firebat}"
            },
            {
              "type": "trade",
              "codes": [
                "{code}"
              ],
              "isOnlyRealtime": true
            },
            {
              "format": "DEFAULT"
            }
          ]
        },
        "realtimeMatch": "trade",
        "tick1s": {
          "type": {
            "field": "type",
            "equals": "trade"
          },
          "symbol": "code",
          "map": {
            "price": "trade_price",
            "signedVolume": {
              "field": "trade_volume",
              "negateWhen": {
                "field": "ask_bid",
                "equals": "ASK"
              }
            }
          }
        }
      }
    }
  },
  "input": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "screen",
          "get_tick_size",
          "get_candles",
          "candle-seconds",
          "candle-minutes",
          "candle-days",
          "candle-weeks",
          "candle-months",
          "candle-years",
          "trades",
          "ticker",
          "ticker-all",
          "orderbook",
          "orderbook-instruments",
          "markets"
        ],
        "description": "업비트 공개 시세 액션. get_candles = 증권사 중립 캔들 계약. screen = 한 마켓의 전 페어를 24시간 누적 거래대금 순으로 정렬한 종목 화면. get_tick_size = 거래소가 말해 주는 호가 단위."
      },
      "market": {
        "type": "string",
        "description": "마켓 코드 (예: KRW-BTC, KRW-ETH, BTC-XRP) — `symbol` 과 같은 뜻입니다."
      },
      "markets": {
        "type": "string",
        "description": "마켓 코드 목록 (쉼표 구분, 예: KRW-BTC,KRW-ETH). ticker/orderbook용"
      },
      "side": {
        "type": "string",
        "enum": [
          "bid",
          "ask"
        ],
        "description": "주문 방향 (bid=매수, ask=매도)"
      },
      "volume": {
        "type": "string",
        "description": "주문 수량 (문자열)"
      },
      "price": {
        "type": "string",
        "description": "주문 가격 (문자열). 시장가 매수 시 총액"
      },
      "ord_type": {
        "type": "string",
        "enum": [
          "limit",
          "price",
          "market",
          "best"
        ],
        "default": "limit",
        "description": "주문 유형 (limit=지정가, price=시장가매수, market=시장가매도, best=최유리)"
      },
      "identifier": {
        "type": "string",
        "description": "사용자 지정 주문 ID"
      },
      "uuid": {
        "type": "string",
        "description": "주문/입출금 UUID"
      },
      "uuids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "UUID 배열 (일괄 조회/취소)"
      },
      "time_in_force": {
        "type": "string",
        "enum": [
          "fok",
          "ioc",
          "post_only"
        ],
        "description": "주문 체결 조건"
      },
      "smp_type": {
        "type": "string",
        "enum": [
          "cancel_maker",
          "cancel_taker",
          "reduce"
        ],
        "description": "자전거래 방지 옵션"
      },
      "unit": {
        "type": "string",
        "enum": [
          "1",
          "3",
          "5",
          "10",
          "15",
          "30",
          "60",
          "240"
        ],
        "description": "분봉 단위 (candle-minutes용)"
      },
      "to": {
        "type": "string",
        "description": "캔들 조회 종료 시각 (ISO 8601 또는 HHmmss)"
      },
      "count": {
        "type": "integer",
        "default": 200,
        "description": "조회 개수 (캔들 최대 200, 체결 최대 500)"
      },
      "converting_price_unit": {
        "type": "string",
        "description": "환산 화폐 단위 (candle-days용, 예: KRW)"
      },
      "cursor": {
        "type": "string",
        "description": "페이지네이션 커서 (sequential_id 등)"
      },
      "days_ago": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7,
        "description": "최근 체결 내역 n일 전 조회 (trades용)"
      },
      "level": {
        "type": "string",
        "default": "0",
        "description": "호가 모아보기 레벨 (orderbook용)"
      },
      "quote_currencies": {
        "type": "string",
        "description": "호가 통화 목록 (ticker-all용, 예: KRW,BTC)"
      },
      "is_details": {
        "type": "boolean",
        "description": "상세 정보 포함 여부 (markets용)"
      },
      "currency": {
        "type": "string",
        "description": "통화 코드 (예: BTC, ETH). 입출금 조회/요청용"
      },
      "net_type": {
        "type": "string",
        "description": "블록체인 네트워크 타입 (예: ETH, TRX, SOL)"
      },
      "address": {
        "type": "string",
        "description": "출금 수신 주소"
      },
      "secondary_address": {
        "type": "string",
        "description": "보조 주소 (태그/메모, XRP 등)"
      },
      "amount": {
        "type": "string",
        "description": "입출금 금액 (문자열)"
      },
      "transaction_type": {
        "type": "string",
        "enum": [
          "default",
          "internal"
        ],
        "description": "출금 거래 유형 (default=일반, internal=내부이체)"
      },
      "two_factor_type": {
        "type": "string",
        "enum": [
          "kakao",
          "naver",
          "hana"
        ],
        "description": "2차 인증 방식 (원화 입출금용)"
      },
      "state": {
        "type": "string",
        "description": "상태 필터 (입출금/주문 조회용)"
      },
      "states": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "상태 배열 필터 (주문 조회용)"
      },
      "order_by": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "default": "desc",
        "description": "정렬 순서"
      },
      "page": {
        "type": "integer",
        "default": 1,
        "description": "페이지 번호"
      },
      "limit": {
        "type": "integer",
        "default": 100,
        "description": "페이지당 조회 개수"
      },
      "from": {
        "type": "string",
        "description": "조회 시작점 (커서/날짜)"
      },
      "txid": {
        "type": "string",
        "description": "트랜잭션 ID (입출금 조회)"
      },
      "txids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "트랜잭션 ID 배열"
      },
      "prev_order_uuid": {
        "type": "string",
        "description": "정정 대상 원주문 UUID (order-cancel-and-new용)"
      },
      "prev_order_identifier": {
        "type": "string",
        "description": "정정 대상 원주문 식별자 (order-cancel-and-new용)"
      },
      "new_ord_type": {
        "type": "string",
        "enum": [
          "limit",
          "best"
        ],
        "description": "정정 주문 유형 (order-cancel-and-new용)"
      },
      "new_volume": {
        "type": "string",
        "description": "정정 주문 수량"
      },
      "new_price": {
        "type": "string",
        "description": "정정 주문 가격"
      },
      "new_identifier": {
        "type": "string",
        "description": "정정 주문 식별자"
      },
      "new_time_in_force": {
        "type": "string",
        "enum": [
          "fok",
          "ioc",
          "post_only"
        ],
        "description": "정정 주문 체결 조건"
      },
      "new_smp_type": {
        "type": "string",
        "enum": [
          "cancel_maker",
          "cancel_taker",
          "reduce"
        ],
        "description": "정정 주문 자전거래 방지"
      },
      "endpoint": {
        "type": "string",
        "description": "API 경로 직접 지정 (예: /v1/candles/days)"
      },
      "method": {
        "type": "string",
        "enum": [
          "GET",
          "POST",
          "DELETE"
        ],
        "default": "GET",
        "description": "HTTP 메서드 (endpoint 직접 호출 시)"
      },
      "params": {
        "type": "object",
        "description": "API별 추가 파라미터 (endpoint 직접 호출 시)"
      },
      "symbol": {
        "type": "string",
        "description": "마켓 코드 (예: KRW-BTC) — `market` 과 같은 뜻이며 둘 중 아무거나 씁니다."
      },
      "interval": {
        "type": "string",
        "description": "봉 주기: 1m·3m·5m·10m·15m·30m·60m(=1h)·240m(=4h)·1d·1w·1M·1y·`<N>s`."
      },
      "quote": {
        "type": "string",
        "description": "[screen] 기준 통화 (KRW·BTC·USDT, 기본 KRW)."
      },
      "top": {
        "type": "number",
        "description": "[screen] 상위 몇 개 (1~50, 기본 10)."
      },
      "minTurnover": {
        "type": "number",
        "description": "[screen] 24시간 거래대금 하한 (원). 얇은 종목 제외."
      },
      "includeFlagged": {
        "type": "boolean",
        "description": "[screen] 유의·주의 종목도 포함할지 (기본 false). 거래량 급등 경보가 있어서, 거래대금 순 정렬은 경보 종목을 가장 먼저 집습니다."
      },
      "bars": {
        "type": "number",
        "description": "[get_candles] 원하는 총 봉 개수. 200을 넘으면 `to` 커서로 과거 방향 페이징합니다(상한 20000). 5분봉 200개는 16시간뿐이라 스캘핑 규칙 측정에는 모자랍니다."
      },
      "qty": {
        "type": "number",
        "description": "[중립 계약] 수량. 업비트는 소수점 8자리까지."
      },
      "orderType": {
        "type": "string",
        "description": "[중립 계약] 'limit' 또는 'market'. 시장가 매수는 총액(price 또는 amount), 시장가 매도는 수량입니다."
      },
      "clientOrderId": {
        "type": "string",
        "description": "[중립 계약] 우리 주문키. 업비트 `identifier` 로 전달되어 재전송이 거래소 단에서 거부됩니다."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "description": "요청한 액션명"
      },
      "endpoint": {
        "type": "string",
        "description": "호출된 API 경로"
      },
      "data": {
        "type": "object",
        "description": "API 응답 데이터 (API별로 다름)"
      }
    },
    "additionalProperties": true
  },
  "hubSafe": true,
  "tags": [
    "Upbit",
    "암호화폐",
    "가상자산",
    "업비트",
    "시세",
    "현재가",
    "호가",
    "체결",
    "캔들",
    "티커",
    "마켓",
    "호가단위",
    "거래대금 순위",
    "키 불요"
  ]
}
