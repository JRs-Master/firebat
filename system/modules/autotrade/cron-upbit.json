{
  "title": "autotrade (가상화폐/업비트) — KRW-ETH 1h cycle",
  "cronTime": "0 */5 * * * *",
  "executionMode": "pipeline",
  "pipeline": [
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "gate"
      }
    },
    {
      "type": "CONDITION",
      "field": "active",
      "op": "==",
      "value": true
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_upbit",
      "inputData": {
        "action": "get_candles",
        "bars": 300
      },
      "inputMap": {
        "symbol": "$step0.trade.symbol",
        "interval": "$step0.trade.interval"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_technical-analysis",
      "inputData": {
        "action": "signals",
        "feeRate": 0.0005,
        "taxRate": 0,
        "slippageRate": 0.0002
      },
      "inputMap": {
        "rules": "$step0.strategy.rules",
        "barsCacheKey": "$step2._cacheKey"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "cycle"
      },
      "inputMap": {
        "signal": "$step3",
        "barsCacheKey": "$step2._cacheKey",
        "symbol": "$step0.trade.symbol"
      }
    },
    {
      "type": "FOREACH",
      "items": "$step4.calls",
      "steps": [
        {
          "type": "TOOL_CALL",
          "tool": "sysmod_upbit",
          "inputData": "$prev.input"
        }
      ]
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "record_orders"
      },
      "inputMap": {
        "calls": "$step4.calls",
        "results": "$step5"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_upbit",
      "inputData": {
        "action": "list_fills"
      },
      "inputMap": {
        "symbol": "$step0.trade.symbol"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_upbit",
      "inputData": {
        "action": "list_open_orders"
      },
      "inputMap": {
        "symbol": "$step0.trade.symbol"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_upbit",
      "inputData": {
        "action": "get_balance"
      }
    },
    {
      "type": "TOOL_CALL",
      "tool": "sysmod_autotrade",
      "inputData": {
        "action": "reconcile"
      },
      "inputMap": {
        "fills": "$step7.rows",
        "openOrders": "$step8.rows",
        "balanceRows": "$step9.rows",
        "symbol": "$step0.trade.symbol"
      }
    }
  ]
}
