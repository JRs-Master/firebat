{
  "name": "korea-invest-trade",
  "type": "module",
  "scope": "system",
  "version": "1.0.0",
  "description": "한국투자증권 계좌·주문 — 국내·해외주식과 선물옵션·채권의 주문·잔고·체결내역·예수금·매수가능조회. 계좌 등록(앱키·CANO)이 있는 쪽.",
  "aliases": [
    "한투",
    "한국투자증권",
    "한국투자",
    "KIS"
  ],
  "runtime": "node",
  "capability": "stock-order",
  "providerType": "api",
  "actionCatalog": {
    "file": "actions.json",
    "envelope": "{ \"action\": \"<id>\", \"query\": { <query.* params> }, \"body\": { <body.* params> } } — param key prefix query./body. marks the location"
  },
  "grounding": {
    "FID_INPUT_ISCD": {
      "pattern": "^Q?[0-9]{6}$",
      "resolveHint": "A 6-digit domestic stock code (FID_INPUT_ISCD) must come from a lookup, never from memory. To resolve a company name to its code, call the stock-lookup tool directly NOW: sysmod_stock-lookup {\"query\":\"<company name>\"} (underscore form sysmod_stock_lookup also works). One arg, one call — this is a direct tool call, NOT something to find with search_module_actions (never search for \"lookup\"). It returns the official corp_name + stock_code (e.g. LG에너지솔루션 → 373220); if several companies match it returns candidates — ask the user with a suggest picker when unsure. The resolved code then works here in the same conversation. If the user gave a raw code, confirm it the same way (stock-lookup accepts a 6-digit code and returns the company). Index/sector codes (0001 코스피, 1001 코스닥) and member-firm codes are fixed reference codes and are not gated.",
      "exemptActions": []
    },
    "PDNO": {
      "pattern": "^Q?[0-9]{6}$",
      "resolveHint": "A 6-digit order/holdings stock code (PDNO) must come from a lookup or the user, never invented — a wrong code means trading the wrong stock. To resolve a company name to its code, call the stock-lookup tool directly NOW: sysmod_stock-lookup {\"query\":\"<company name>\"} (underscore form sysmod_stock_lookup also works). One arg, one call — this is a direct tool call, NOT something to find with search_module_actions (never search for \"lookup\"). It returns the official corp_name + stock_code (e.g. LG에너지솔루션 → 373220); if several companies match it returns candidates — ask the user with a suggest picker when unsure. Bond/product codes (KR...) are not affected.",
      "exemptActions": []
    }
  },
  "accounts": {
    "modes": [
      "real",
      "mock"
    ],
    "markets": [
      "kr",
      "us"
    ]
  },
  "secrets": [
    {
      "name": "KIS_APP_KEY",
      "type": "key"
    },
    {
      "name": "KIS_APP_SECRET",
      "type": "key"
    },
    {
      "name": "KIS_ACCESS_TOKEN",
      "type": "token",
      "lifetimeSec": 85800,
      "oauth": {
        "base": "https://openapi.koreainvestment.com:9443",
        "baseMock": "https://openapivts.koreainvestment.com:29443",
        "path": "/oauth2/tokenP",
        "method": "POST",
        "contentType": "application/json",
        "body": {
          "grant_type": "client_credentials",
          "appkey": "${KIS_APP_KEY}",
          "appsecret": "${KIS_APP_SECRET}"
        },
        "tokenField": "access_token",
        "invalidWhen": {
          "match": "all",
          "conditions": [
            {
              "field": "rt_cd",
              "equals": "1"
            },
            {
              "field": "msg1",
              "regex": "token|토큰"
            }
          ]
        }
      }
    },
    {
      "name": "KIS_WS_APPROVAL_KEY",
      "type": "token",
      "lifetimeSec": 84600,
      "oauth": {
        "base": "https://openapi.koreainvestment.com:9443",
        "baseMock": "https://openapivts.koreainvestment.com:29443",
        "path": "/oauth2/Approval",
        "method": "POST",
        "contentType": "application/json",
        "body": {
          "grant_type": "client_credentials",
          "appkey": "${KIS_APP_KEY}",
          "secretkey": "${KIS_APP_SECRET}"
        },
        "tokenField": "approval_key"
      }
    }
  ],
  "ws": {
    "endpoint": "ws://ops.koreainvestment.com:21000",
    "endpointMock": "ws://ops.koreainvestment.com:31000",
    "matchField": "header.tr_id",
    "echoValues": [
      "PINGPONG"
    ],
    "tokenSecret": "KIS_WS_APPROVAL_KEY",
    "errorMsgField": "body.msg1",
    "_note": "한투 실시간 — approval_key(구독 헤더) + 구분자 프레임(ws.frame). 시세=평문(flag0)/체결통보=AES256(flag1, 구독 응답 iv·key). 값은 위치로 나가고(field_0…) 이름은 읽는 쪽이 붙인다.",
    "streams": {
      "exec-notify": {
        "trId": "H0STCNI0",
        "trIdMock": "H0STCNI9",
        "realtimeMatch": "H0STCNI0",
        "desc": "국내주식 실시간체결통보",
        "keyDesc": "HTS ID",
        "subscribe": {
          "frame": {
            "header": {
              "approval_key": "{TOKEN}",
              "custtype": "P",
              "tr_type": "1",
              "content-type": "utf-8"
            },
            "body": {
              "input": {
                "tr_id": "H0STCNI0",
                "tr_key": "{key}"
              }
            }
          },
          "match": "H0STCNI0",
          "successWhen": {
            "field": "body.rt_cd",
            "equals": "0"
          }
        },
        "unsubscribe": {
          "frame": {
            "header": {
              "approval_key": "{TOKEN}",
              "custtype": "P",
              "tr_type": "2",
              "content-type": "utf-8"
            },
            "body": {
              "input": {
                "tr_id": "H0STCNI0",
                "tr_key": "{key}"
              }
            }
          }
        },
        "decrypt": {
          "ivField": "body.output.iv",
          "keyField": "body.output.key"
        }
      },
