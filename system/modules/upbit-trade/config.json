{
  "name": "upbit-trade",
  "type": "module",
  "scope": "system",
  "version": "1.0.0",
  "description": "업비트 계좌·주문·입출금 — 잔고·주문(지정가·시장가·정정·취소)·체결내역·주문가능정보·입출금·출금주소. 개인 키로 서명하는 쪽.",
  "aliases": [
    "업비트",
    "Upbit"
  ],
  "runtime": "node",
  "capability": "crypto-order",
  "providerType": "api",
  "secrets": [
    "UPBIT_ACCESS_KEY",
    "UPBIT_SECRET_KEY"
  ],
  "input": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "accounts",
          "order-chance",
          "order-detail",
          "order-create",
          "order-cancel",
          "order-cancel-and-new",
          "order-cancel-uuids",
          "order-cancel-open",
          "order-list-uuids",
          "order-list-closed",
          "order-list-open",
          "order-test",
          "withdraw-detail",
          "withdraw-list",
          "withdraw-cancel",
          "withdraw-coin",
          "withdraw-krw",
          "withdraw-addresses",
          "withdraw-chance",
          "deposit-detail",
          "deposit-list",
          "deposit-create-address",
          "deposit-krw",
          "deposit-addresses",
          "deposit-address",
          "deposit-chance",
          "wallet-status",
          "api-keys",
          "place_order",
          "cancel_order",
          "list_open_orders",
          "list_fills",
          "get_balance"
        ],
        "description": "업비트 계좌·주문·입출금 액션. place_order · cancel_order · list_open_orders · list_fills · get_balance = 증권사 중립 계약 — 이 증권사의 API ID 를 몰라도 되는 표준 호출. 매수 시장가는 `ord_type:price` + `price` 가 총액, 매도는 `market` + `volume` 입니다."
      },
      "market": {
        "type": "string",
        "description": "마켓 코드 (예: KRW-BTC, KRW-ETH, BTC-XRP)"
      },
      "markets": {
        "type": "string",
        "description": "마켓 코드 목록 (쉼표 구분, 예: KRW-BTC,KRW-ETH). ticker/orderbook용"
      },
      "side": {
        "type": "string",
        "enum": [
          "buy",
          "sell",
          "bid",
          "ask"
        ],
        "description": "Order side. The exchange's own words are `bid` (buy) and `ask` (sell); the neutral contract's `buy`/`sell` name the same thing and are accepted, because input validation runs before the module and would otherwise refuse a neutral `place_order` before the dialect could translate it."
      },
      "volume": {
        "type": "string",
        "description": "주문 수량 (문자열)"
      },
      "price": {
        "type": "string",
        "description": "주문 가격 (문자열). 시장가 매수 시 총액"
      },
      "ord_type": {
        "type": "string",
        "enum": [
          "limit",
          "price",
          "market",
          "best"
        ],
        "default": "limit",
        "description": "주문 유형 (limit=지정가, price=시장가매수, market=시장가매도, best=최유리)"
      },
      "identifier": {
        "type": "string",
        "description": "사용자 지정 주문 ID"
      },
      "uuid": {
        "type": "string",
        "description": "주문/입출금 UUID"
      },
      "uuids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "UUID 배열 (일괄 조회/취소)"
      },
      "time_in_force": {
        "type": "string",
        "enum": [
          "fok",
          "ioc",
          "post_only"
        ],
        "description": "주문 체결 조건"
      },
      "smp_type": {
        "type": "string",
        "enum": [
          "cancel_maker",
          "cancel_taker",
          "reduce"
        ],
        "description": "자전거래 방지 옵션"
      },
      "unit": {
        "type": "string",
        "enum": [
          "1",
          "3",
          "5",
          "10",
          "15",
          "30",
          "60",
          "240"
        ],
        "description": "분봉 단위 (candle-minutes용)"
      },
      "to": {
        "type": "string",
        "description": "캔들 조회 종료 시각 (ISO 8601 또는 HHmmss)"
      },
      "count": {
        "type": "integer",
        "default": 200,
        "description": "조회 개수 (캔들 최대 200, 체결 최대 500)"
      },
      "converting_price_unit": {
        "type": "string",
        "description": "환산 화폐 단위 (candle-days용, 예: KRW)"
      },
      "cursor": {
        "type": "string",
        "description": "페이지네이션 커서 (sequential_id 등)"
      },
      "days_ago": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7,
        "description": "최근 체결 내역 n일 전 조회 (trades용)"
      },
      "level": {
        "type": "string",
        "default": "0",
        "description": "호가 모아보기 레벨 (orderbook용)"
      },
      "quote_currencies": {
        "type": "string",
        "description": "호가 통화 목록 (ticker-all용, 예: KRW,BTC)"
      },
      "is_details": {
        "type": "boolean",
        "description": "상세 정보 포함 여부 (markets용)"
      },
      "currency": {
        "type": "string",
        "description": "통화 코드 (예: BTC, ETH). 입출금 조회/요청용"
      },
      "net_type": {
        "type": "string",
        "description": "블록체인 네트워크 타입 (예: ETH, TRX, SOL)"
      },
      "address": {
        "type": "string",
        "description": "출금 수신 주소"
      },
      "secondary_address": {
        "type": "string",
        "description": "보조 주소 (태그/메모, XRP 등)"
      },
      "amount": {
        "type": "string",
        "description": "입출금 금액 (문자열)"
      },
      "transaction_type": {
        "type": "string",
        "enum": [
          "default",
          "internal"
        ],
        "description": "출금 거래 유형 (default=일반, internal=내부이체)"
      },
      "two_factor_type": {
        "type": "string",
        "enum": [
          "kakao",
          "naver",
          "hana"
        ],
        "description": "2차 인증 방식 (원화 입출금용)"
      },
      "state": {
        "type": "string",
        "description": "상태 필터 (입출금/주문 조회용)"
      },
      "states": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "상태 배열 필터 (주문 조회용)"
      },
      "order_by": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "default": "desc",
        "description": "정렬 순서"
      },
      "page": {
        "type": "integer",
        "default": 1,
        "description": "페이지 번호"
      },
      "limit": {
        "type": "integer",
        "default": 100,
        "description": "페이지당 조회 개수"
      },
      "from": {
        "type": "string",
        "description": "조회 시작점 (커서/날짜)"
      },
      "txid": {
        "type": "string",
        "description": "트랜잭션 ID (입출금 조회)"
      },
      "txids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "트랜잭션 ID 배열"
      },
      "prev_order_uuid": {
        "type": "string",
        "description": "정정 대상 원주문 UUID (order-cancel-and-new용)"
      },
      "prev_order_identifier": {
        "type": "string",
        "description": "정정 대상 원주문 식별자 (order-cancel-and-new용)"
      },
      "new_ord_type": {
        "type": "string",
        "enum": [
          "limit",
          "best"
        ],
        "description": "정정 주문 유형 (order-cancel-and-new용)"
      },
      "new_volume": {
        "type": "string",
        "description": "정정 주문 수량"
      },
      "new_price": {
        "type": "string",
        "description": "정정 주문 가격"
      },
      "new_identifier": {
        "type": "string",
        "description": "정정 주문 식별자"
      },
      "new_time_in_force": {
        "type": "string",
        "enum": [
          "fok",
          "ioc",
          "post_only"
        ],
        "description": "정정 주문 체결 조건"
      },
      "new_smp_type": {
        "type": "string",
        "enum": [
          "cancel_maker",
          "cancel_taker",
          "reduce"
        ],
        "description": "정정 주문 자전거래 방지"
      },
      "endpoint": {
        "type": "string",
        "description": "API 경로 직접 지정 (예: /v1/candles/days)"
      },
      "method": {
        "type": "string",
        "enum": [
          "GET",
          "POST",
          "DELETE"
        ],
        "default": "GET",
        "description": "HTTP 메서드 (endpoint 직접 호출 시)"
      },
      "params": {
        "type": "object",
        "description": "API별 추가 파라미터 (endpoint 직접 호출 시)"
      },
      "symbol": {
        "type": "string",
        "description": "get_candles 마켓 코드 (예: KRW-BTC)."
      },
      "interval": {
        "type": "string",
        "description": "봉 주기: 1m·3m·5m·10m·15m·30m·60m(=1h)·240m(=4h)·1d·1w·1M·1y·`<N>s`."
      },
      "quote": {
        "type": "string",
        "description": "[screen] 기준 통화 (KRW·BTC·USDT, 기본 KRW)."
      },
      "top": {
        "type": "number",
        "description": "[screen] 상위 몇 개 (1~50, 기본 10)."
      },
      "minTurnover": {
        "type": "number",
        "description": "[screen] 24시간 거래대금 하한 (원). 얇은 종목 제외."
      },
      "includeFlagged": {
        "type": "boolean",
        "description": "[screen] 유의·주의 종목도 포함할지 (기본 false). 거래량 급등 경보가 있어서, 거래대금 순 정렬은 경보 종목을 가장 먼저 집습니다."
      },
      "bars": {
        "type": "number",
        "description": "[get_candles] 원하는 총 봉 개수. 200을 넘으면 `to` 커서로 과거 방향 페이징합니다(상한 20000). 5분봉 200개는 16시간뿐이라 스캘핑 규칙 측정에는 모자랍니다."
      },
      "qty": {
        "type": "number",
        "description": "[중립 계약] 수량. 업비트는 소수점 8자리까지."
      },
      "orderType": {
        "type": "string",
        "description": "[중립 계약] 'limit' 또는 'market'. 시장가 매수는 총액(price 또는 amount), 시장가 매도는 수량입니다."
      },
      "clientOrderId": {
        "type": "string",
        "description": "[중립 계약] 우리 주문키. 업비트 `identifier` 로 전달되어 재전송이 거래소 단에서 거부됩니다."
      },
      "brokerOrderNo": {
        "type": "string",
        "description": "cancel_order — the broker's own order number, `uuid` here. Part of the neutral contract: the caller holds one identifier whatever the broker calls it."
      },
      "mock": {
        "type": "boolean",
        "description": "Route to the practice endpoint where the broker has one. Upbit does not, so this is accepted and ignored — the neutral contract passes it to every broker."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "description": "요청한 액션명"
      },
      "endpoint": {
        "type": "string",
        "description": "호출된 API 경로"
      },
      "data": {
        "type": "object",
        "description": "API 응답 데이터 (API별로 다름)"
      }
    },
    "additionalProperties": true
  },
  "requiresApproval": [
    "order-create",
    "order-cancel",
    "order-cancel-and-new",
    "order-cancel-uuids",
    "order-cancel-open",
    "withdraw-coin",
    "withdraw-krw",
    "withdraw-cancel",
    "deposit-krw",
    "deposit-create-address",
    "place_order",
    "cancel_order"
  ],
  "ws": {
    "endpoint": "wss://api.upbit.com/websocket/v1/private",
    "matchField": "type",
    "keepalive": "PING",
    "login": {
      "headers": {
        "Authorization": "Bearer {JWT}"
      },
      "jwt": {
        "algorithm": "HS512",
        "accessKeySecret": "UPBIT_ACCESS_KEY",
        "secretKeySecret": "UPBIT_SECRET_KEY",
        "accessClaim": "access_key",
        "nonceClaim": "nonce"
      }
    },
    "streams": {
      "myOrder": {
        "desc": "내 주문·체결 실시간 (계좌 — 주문 접수·정정·취소·체결 push)",
        "keyDesc": "없음 — 계좌 단위 구독이라 종목을 지정하지 않습니다. 자격증명이 곧 계좌입니다.",
        "description": "My order and fill events. Fires the moment the exchange books a fill, instead of the next poll.",
        "subscribe": {
          "frame": [
            {
              "ticket": "firebat-myorder"
            },
            {
              "type": "myOrder",
              "codes": [
                "{codes?}"
              ]
            },
            {
              "format": "DEFAULT"
            }
          ]
        },
        "realtimeMatch": "myOrder",
        "routeItemPath": "code"
      },
      "myAsset": {
        "desc": "내 자산 실시간 (계좌 — 보유 수량·주문가능 금액 변동 push)",
        "keyDesc": "없음 — 계좌 단위 구독이라 종목을 지정하지 않습니다.",
        "description": "My balance changes. Whole account — the frame carries every asset that moved.",
        "subscribe": {
          "frame": [
            {
              "ticket": "firebat-myasset"
            },
            {
              "type": "myAsset"
            },
            {
              "format": "DEFAULT"
            }
          ]
        },
        "realtimeMatch": "myAsset"
      }
    },
    "frame": {
      "kind": "json"
    }
  },
  "hubSafe": false,
  "tags": [
    "Upbit",
    "암호화폐",
    "가상자산",
    "업비트",
    "주문",
    "매수",
    "매도",
    "정정취소",
    "계좌",
    "잔고",
    "체결내역",
    "주문가능정보",
    "입금",
    "출금",
    "실시간 체결통보"
  ]
}
